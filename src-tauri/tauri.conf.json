{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Civ The Game",
  "version": "0.1.0",
  "identifier": "com.civ.thegame",
  "build": {
    "frontendDist": "frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Civ The Game",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"]
  }
}
