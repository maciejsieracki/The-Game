+
+export function removeTreatiesByIdLogged(state: ActiveDeal[], ids: readonly string[], label: string, turn: number): ActiveDeal[] {
+  if (!ids.length) return state;
+  const drop = new Set(ids);
+  for (const d of state) if (drop.has(d.id)) console.log('[AA-REMOVE] t' + turn + ' sciezka=' + label + ' id=' + d.id + ' rodzaj=' + d.rodzaj + ' strony=' + JSON.stringify(d.strony) + ' wygasaTura=' + d.wygasaTura + ' zawarta=' + d.zawartaTura);
+  return state.filter(d => !drop.has(d.id));
+}
+export function expireTreatiesLogged(state: ActiveDeal[], turn: number): ActiveDeal[] {
+  const out = expireTreaties(state, turn);
+  const kept = new Set(out.map(d => d.id));
+  for (const d of state) if (!kept.has(d.id)) console.log('[AA-REMOVE] t' + turn + ' sciezka=wygasniecie-expireTreaties id=' + d.id + ' rodzaj=' + d.rodzaj + ' strony=' + JSON.stringify(d.strony) + ' wygasaTura=' + d.wygasaTura + ' zawarta=' + d.zawartaTura);
+  return out;
+}
