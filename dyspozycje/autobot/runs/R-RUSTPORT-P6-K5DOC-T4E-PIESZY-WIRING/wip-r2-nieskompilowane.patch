+//! P6 SIEGE-TAKTYKA K5DOC-T4e-0 (dispatch R-RUSTPORT-P6-K5DOC-T4E-PIESZY-WIRING, runda 2, DODATEK D1-D4): wpięcie
+//! ruchu pieszego w `ProdBody` przez `ProdBody::move_step` -> `do_move_effects`.
+//!
+//! Zakres T4e-0 (D4): typ `MoveTerrain`, pola `terrain` i `occ_by_key` w `ProdBody`, jedna ścieżka ruchu
+//! (krok -> `do_move_effects`), brak terenu = `MissingTerrain` (bez domyślnej wartości).
+//! POZA zakresem (T4e-1): pełne `_advanceStep` 1-10, kawaleria, brody jako decyzja kroku.
+//!
+//! Oczekiwania wyprowadzone z pina `07d2fbd72` (`gra/src/battle/battleScene.ts`):
+//! * `_doMove` `:8685-8776`: zajętość (`occByKey`), pozycja, koszt kroku z clampem `[1, 99]`, brod `/ 0.5`,
+//!   `moveLeft = max(0, moveLeft - stepCost)`, facing jako wejście.
+//! * `_doMove` `:8689-8692`: odmowa -> `moveLeft = 0`, bez zmiany zajętości i pozycji.
+//! * `_advanceStep` `:8198` / `_doMove` kolejność: `occByKey` przed facing (`:8694-8704`).
+//! Wektory są wpisane w kod testu (nie generowane przez `*_gen.mjs`); to jawnie NIE jest wykonanie tekstu pina.
+
+use std::collections::{BTreeSet, HashMap};
+
+use civ_engine::domain::siege_tactics_activate::{ActivateScene, ActivateUnit};
+use civ_engine::domain::siege_tactics_autobatch::{cell_key, CellKey};
+use civ_engine::domain::siege_tactics_blow::SequenceRolls;
+use civ_engine::domain::siege_tactics_end::BattleSide;
+use civ_engine::domain::siege_tactics_loop::{LoopBody, ProdBody, ProdMoveError, ProdUnit};
+use civ_engine::domain::siege_tactics_move_effects::{
+    do_move_effects, MoveOutcome, MoveTerrain, MoveUnit, MoveWorld,
+};
+use civ_engine::domain::siege_tactics_turnseq::{SeqUnit, TurnSeqState, UnitRef};
+use civ_engine::domain::siege_tactics_unit::CombatUnit;
+
+/// Teren testowy: stały koszt, opcjonalny brod na jednym kafelku, zapis wywołań `passable`.
+struct TestTerrain {
+    cost: f64,
+    ford: Option<(f64, f64)>,
+}
+
+impl MoveTerrain for TestTerrain {
+    fn passable(&self, _col: f64, _row: f64) -> bool {
+        true
+    }
+    fn move_cost(&self, _col: f64, _row: f64) -> f64 {
+        self.cost
+    }
+    fn is_ford(&self, col: f64, row: f64) -> bool {
+        self.ford == Some((col, row))
+    }
+    fn combat_terrain_name(&self, _col: f64, _row: f64) -> String {
+        "Równina".to_string()
+    }
+    fn cavalry_mult(&self) -> f64 {
+        1.0
+    }
+}
+
+fn cu(move_left: f64) -> CombatUnit {
+    CombatUnit {
+        hp: 100.0,
+        morale: 100.0,
+        flee_morale: 0.0,
+        move_left,
+        never_rout: false,
+        dead: false,
+        fading_out: false,
+        routed: false,
+        removed: false,
+        acted: false,
+    }
+}
+
+fn act(q: i64, r: i64, side_atk: bool) -> ActivateUnit {
+    ActivateUnit {
+        side_atk,
+        q,
+        r,
+        dead: false,
+        fading_out: false,
+        routed: false,
+        never_rout: false,
+        surround_applied: false,
+        morale: 100.0,
+        flee_morale: 0.0,
+        terrain_defence_mult: 1.0,
+        range: 1.0,
+        on_wall_walkway: false,
+        primary_ranged: false,
+        mounted: false,
+        phalanx: false,
+        shooting_disabled: false,
+        dry_col: 0.0,
+        held_after_fallback: false,
+        player_order_none: true,
+        can_shoot: false,
+        is_siege_unit: false,
+        is_siege_tower: false,
+        is_ram: false,
+        is_catapult: false,
+        doctrine_auto: false,
+        doctrine_manual: false,
+    }
+}
+
+fn scene() -> ActivateScene {
+    ActivateScene {
+        finished: false,
+        manual_mode: false,
+        is_player_side: false,
+        wall_col: -1,
+        gate_open: false,
+        wall_tile_hp: Vec::new(),
+        siege_machine_range: 0.0,
+    }
+}
+
+fn pu(q: i64, r: i64, side_atk: bool) -> ProdUnit {
+    ProdUnit {
+        activate: act(q, r, side_atk),
+        melee_target: None,
+        blow: None,
+        counter_blows: Vec::new(),
+        body_ms: 0.0,
+        facing: 0.0,
+    }
+}
+
+/// Atakujący `atk0` na (0,0) z `move_left`, obrońca `def0` daleko na (5,5).
+fn body_and_state(move_left: f64) -> (ProdBody<SequenceRolls>, TurnSeqState) {
+    let body = ProdBody::new(
+        [vec![pu(0, 0, true)], vec![pu(5, 5, false)]],
+        scene(),
+        SequenceRolls::new(Vec::new()),
+    );
+    let st = TurnSeqState {
+        atk: vec![SeqUnit {
+            id: 1,
+            c: cu(move_left),
+        }],
+        def: vec![SeqUnit { id: 2, c: cu(0.0) }],
+        turn_order: Vec::new(),
+        turn_idx: 0,
+        round_no: 1,
+        siege_wall_col: -1,
+        manual_mode: false,
+        player_side: BattleSide::Attacker,
+        finished: false,
+        awaiting_orders: false,
+        auto_battle_suspended: false,
+        busy: false,
+        auto_batch_planning: false,
+        queued_order_ids: BTreeSet::new(),
+    };
+    (body, st)
+}
+
+fn atk0() -> UnitRef {
+    UnitRef {
+        side: BattleSide::Attacker,
+        idx: 0,
+    }
+}
+
+fn flat(cost: f64) -> Box<dyn MoveTerrain> {
+    Box::new(TestTerrain { cost, ford: None })
+}
+
+/// Wektor zajętości: dokładnie te pary (klucz kafelka, id), bez innych wpisów.
+fn occ_expect(pairs: &[(f64, f64, &str)]) -> HashMap<CellKey, String> {
+    pairs
+        .iter()
+        .map(|(c, r, id)| (cell_key(*c, *r), id.to_string()))
+        .collect()
+}
+
+// ---- Zajętość startowa (konstruktor) ----------------------------------------------------------------------------
+
+#[test]
+fn konstruktor_inicjalizuje_occ_z_pozycji_jednostek() {
+    let (body, _st) = body_and_state(10.0);
+    assert_eq!(
+        body.occ_by_key(),
+        &occ_expect(&[(0.0, 0.0, "atk0"), (5.0, 5.0, "def0")])
+    );
+}
+
+// ---- Ruch jedną ścieżką: zajętość, pozycja, koszt (pin `_doMove` :8694-8703) -------------------------------------
+
+#[test]
+fn ruch_zwykly_aktualizuje_occ_pozycje_i_move_left() {
+    let (mut body, mut st) = body_and_state(10.0);
+    body.set_terrain(flat(2.0));
+    let out = body.move_step(&mut st, atk0(), 1.0, 0.0, false);
+    // Pin: enterCost = max(1, min(2, 99)) = 2, brak brodu, moveLeft = max(0, 10 - 2) = 8.
+    assert_eq!(out, Ok(MoveOutcome { done: false }));
+    assert_eq!(st.unit(atk0()).c.move_left, 8.0);
+    assert_eq!(
+        body.occ_by_key(),
+        &occ_expect(&[(1.0, 0.0, "atk0"), (5.0, 5.0, "def0")])
+    );
+    assert_eq!(body.unit_cell(atk0()), Some((1, 0)));
+}
+
+#[test]
+fn ruch_clamp_kosztu_infinity_daje_99_i_zero_move_left() {
+    // Pin: `Infinity` -> clamp do 99 (`js_min`), `moveLeft = max(0, 10 - 99) = 0`.
+    let (mut body, mut st) = body_and_state(10.0);
+    body.set_terrain(flat(f64::INFINITY));
+    body.move_step(&mut st, atk0(), 1.0, 0.0, false).unwrap();
+    assert_eq!(st.unit(atk0()).c.move_left, 0.0);
+}
+
+#[test]
+fn ruch_brod_na_celu_dzieli_koszt_przez_0_5() {
+    // Pin `:8701-8702`: brod na celu -> stepCost = enterCost / 0.5 = 4; moveLeft = 10 - 4 = 6.
+    let (mut body, mut st) = body_and_state(10.0);
+    body.set_terrain(Box::new(TestTerrain {
+        cost: 2.0,
+        ford: Some((1.0, 0.0)),
+    }));
+    body.move_step(&mut st, atk0(), 1.0, 0.0, false).unwrap();
+    assert_eq!(st.unit(atk0()).c.move_left, 6.0);
+}
+
+// ---- Brak terenu: jawny blad, bez domyslnej wartosci i bez zmiany stanu (D1) -----------------------------------
+
+#[test]
+fn brak_terenu_przy_ruchu_zwraca_missing_terrain_bez_zmiany_stanu() {
+    let (mut body, mut st) = body_and_state(10.0);
+    let out = body.move_step(&mut st, atk0(), 1.0, 0.0, false);
+    assert_eq!(out, Err(ProdMoveError::MissingTerrain));
+    assert_eq!(st.unit(atk0()).c.move_left, 10.0, "move_left bez zmian");
+    assert_eq!(
+        body.occ_by_key(),
+        &occ_expect(&[(0.0, 0.0, "atk0"), (5.0, 5.0, "def0")])
+    );
+    assert_eq!(body.unit_cell(atk0()), Some((0, 0)));
+}
+
+#[test]
+fn odmowa_nie_wymaga_terenu_i_zeruje_move_left() {
+    // Pin `_doMove` :8689-8692: odmowa -> moveLeft = 0, zajętość i pozycja bez zmian, bez terenu.
+    let (mut body, mut st) = body_and_state(10.0);
+    let out = body.move_step(&mut st, atk0(), 1.0, 0.0, true);
+    assert_eq!(out, Ok(MoveOutcome { done: true }));
+    assert_eq!(st.unit(atk0()).c.move_left, 0.0);
+    assert_eq!(
+        body.occ_by_key(),
+        &occ_expect(&[(0.0, 0.0, "atk0"), (5.0, 5.0, "def0")])
+    );
+    assert_eq!(body.unit_cell(atk0()), Some((0, 0)));
+}
+
+// ---- Kolejnosc efektow (D4 mutacja c): occByKey przed facing, w jednym rejestrze wywolan -----------------------
+
+struct RecWorld {
+    log: Vec<&'static str>,
+    occ: HashMap<CellKey, String>,
+}
+
+impl MoveWorld for RecWorld {
+    fn occ_mut(&mut self) -> &mut HashMap<CellKey, String> {
+        self.log.push("occ");
+        &mut self.occ
+    }
+    fn move_cost(&self, _col: f64, _row: f64) -> f64 {
+        2.0
+    }
+    fn is_ford(&self, _col: f64, _row: f64) -> bool {
+        false
+    }
+    fn update_facing(&mut self, _unit_id: &str) {
+        self.log.push("facing");
+    }
+}
+
+#[test]
+fn kolejnosc_occ_przed_facing() {
+    let mut w = RecWorld {
+        log: Vec::new(),
+        occ: occ_expect(&[(0.0, 0.0, "atk0")]),
+    };
+    let mut mu = MoveUnit {
+        id: "atk0".to_string(),
+        q: 0.0,
+        r: 0.0,
+        move_left: 10.0,
+    };
+    do_move_effects(&mut w, &mut mu, 1.0, 0.0, false, None);
+    let first_facing = w.log.iter().position(|e| *e == "facing").unwrap();
+    let last_occ = w.log.iter().rposition(|e| *e == "occ").unwrap();
+    assert!(
+        last_occ < first_facing,
+        "occByKey musi być zapisane przed facing, log={:?}",
+        w.log
+    );
+}
+
+// ---- Cykl: dwa kroki pod rzad aktualizuja zajetosc bez pozostawania starego klucza --------------------------
+
+#[test]
+fn dwa_kroki_nie_zostawiaja_starego_klucza() {
+    let (mut body, mut st) = body_and_state(10.0);
+    body.set_terrain(flat(1.0));
+    body.move_step(&mut st, atk0(), 1.0, 0.0, false).unwrap();
+    body.move_step(&mut st, atk0(), 2.0, 0.0, false).unwrap();
+    assert_eq!(
+        body.occ_by_key(),
+        &occ_expect(&[(2.0, 0.0, "atk0"), (5.0, 5.0, "def0")])
+    );
+    assert_eq!(st.unit(atk0()).c.move_left, 8.0);
+}
