+// Kopia 1:1 pinu `map/newGameMapDefaults.ts:144-185` (jakość mapy = ustawienie renderera, nie reguła gry — P5-0 Z9).
+function normQualityLabel(label: string): string {
+  return label.toLowerCase()
+    .replace(/ł/g, 'l')
+    .replace(/[ó]/g, 'o')
+    .replace(/[ąà]/g, 'a')
+    .replace(/[ę]/g, 'e')
+    .replace(/[^a-z0-9]/g, '');
+}
